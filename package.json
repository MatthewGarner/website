{
  "name": "matthew-garner-website",
  "private": true,
  "version": "1.0.0",
  "description": "Markdown publishing and local development for matthewgarner.me",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "postinstall": "npm ci --prefix site",
    "dev": "npm --prefix site run dev --",
    "build": "npm --prefix site run build",
    "build:vercel": "npm --prefix site run build:vercel",
    "build:release": "npm --prefix site run build:release",
    "preview": "npm --prefix site run preview --",
    "check": "npm --prefix site run check",
    "check:hosted": "npm --prefix site run check:hosted --",
    "test": "npm --prefix site test"
  }
}
