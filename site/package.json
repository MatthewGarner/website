{
  "name": "matthew-garner-site",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "build:vercel": "astro build && node --import tsx scripts/package-vercel.ts",
    "build:release": "npm run check && npm run build && npm test && node --import tsx scripts/package-vercel.ts --root",
    "preview": "astro preview",
    "check": "astro check",
    "check:hosted": "node --import tsx scripts/check-hosted.ts",
    "test": "node --import tsx --test tests/*.test.ts"
  },
  "dependencies": {
    "@astrojs/markdown-remark": "7.3.1",
    "@astrojs/rss": "4.0.19",
    "@fontsource-variable/newsreader": "5.3.0",
    "@fontsource-variable/oswald": "5.3.0",
    "@phosphor-icons/core": "2.1.1",
    "astro": "7.3.5",
    "gray-matter": "4.0.3",
    "mdast-util-from-markdown": "2.0.3",
    "rehype-slug": "6.0.0",
    "unist-util-visit": "5.1.0"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@types/mdast": "4.0.4",
    "@types/node": "24.19.0",
    "tsx": "4.23.15",
    "typescript": "6.0.3"
  }
}
