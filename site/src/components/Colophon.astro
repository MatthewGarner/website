<details class="colophon" id="colophon">
  <summary>About this site <span aria-hidden="true" class="colophon-toggle">+</span></summary>
  <section class="colophon-content" aria-labelledby="colophon-title">
    <header class="colophon-intro">
      <div>
        <p class="colophon-label">A note on the making</p>
        <h2 id="colophon-title">A little room to play.</h2>
      </div>
      <p>Set in Oswald and Newsreader. Written in Obsidian, published from Markdown. A few words, and a little movement.</p>
    </header>
    <div class="type-playground">
      <div class="type-sheet" data-paper="cream" data-face="oswald">
        <div class="type-sheet-content">
        <div class="specimen-caption"><span data-face-name>Oswald</span><span>Type specimen · 01</span></div>
        <label for="specimen-text" class="sr-only">Your words</label>
        <textarea id="specimen-text" maxlength="72" rows="3" spellcheck="false" autocomplete="off" aria-describedby="specimen-hint">{'A little\nroom to think.'}</textarea>
        <p id="specimen-hint">Try typing something of your own.</p>
        </div>
      </div>
      <div class="type-controls" hidden>
        <fieldset>
          <legend>Typeface</legend>
          <div class="type-options">
            <label><input type="radio" name="specimen-face" value="oswald" checked /><span>Oswald</span></label>
            <label><input type="radio" name="specimen-face" value="newsreader" /><span>Newsreader</span></label>
          </div>
        </fieldset>
        <div class="weight-control">
          <div class="weight-label"><label for="specimen-weight">Weight</label><output for="specimen-weight" id="specimen-weight-value" aria-live="off">600</output></div>
          <input id="specimen-weight" type="range" min="200" max="700" step="10" value="600" />
          <div class="weight-extents" aria-hidden="true"><span>Light</span><span>Bold</span></div>
        </div>
        <fieldset>
          <legend>Paper colour</legend>
          <div class="paper-options">
            <label><input type="radio" name="specimen-paper" value="cream" checked /><span class="paper-swatch paper-cream" aria-hidden="true"></span><span>Cream</span></label>
            <label><input type="radio" name="specimen-paper" value="lilac" /><span class="paper-swatch paper-lilac" aria-hidden="true"></span><span>Lilac</span></label>
            <label><input type="radio" name="specimen-paper" value="ink" /><span class="paper-swatch paper-ink" aria-hidden="true"></span><span>Ink</span></label>
          </div>
        </fieldset>
        <div class="specimen-actions">
          <button type="button" data-next-phrase>Another phrase <span aria-hidden="true">↗</span></button>
          <button type="button" data-reset-type>Reset</button>
        </div>
        <p class="sr-only" role="status" data-specimen-status></p>
      </div>
    </div>
  </section>
</details>
<script>
  const details = document.querySelector<HTMLDetailsElement>('.colophon')!;
  const summary = details.querySelector('summary')!;
  const content = details.querySelector<HTMLElement>('.colophon-content')!;
  const controls = details.querySelector<HTMLElement>('.type-controls')!;
  const sheet = details.querySelector<HTMLElement>('.type-sheet')!;
  const sheetContent = details.querySelector<HTMLElement>('.type-sheet-content')!;
  const intro = details.querySelector<HTMLElement>('.colophon-intro')!;
  const specimen = details.querySelector<HTMLTextAreaElement>('#specimen-text')!;
  const weight = details.querySelector<HTMLInputElement>('#specimen-weight')!;
  const weightValue = details.querySelector<HTMLOutputElement>('#specimen-weight-value')!;
  const faceName = details.querySelector<HTMLElement>('[data-face-name]')!;
  const status = details.querySelector<HTMLElement>('[data-specimen-status]')!;
  const motion = matchMedia('(prefers-reduced-motion: reduce)');
  let folds: Animation[] = [];
  let specimenAnimation: Animation | undefined;
  const phrases = ['A little\nroom to think.', 'Good things\ntake time.', 'Follow your\ncuriosity.', 'Words worth\nkeeping.'];
  let phrase = 0;
  let desiredOpen = details.open;
  let openingByReader = false;
  let operation = 0;

  function stopSpecimen() {
    specimenAnimation?.cancel();
    specimenAnimation = undefined;
  }
  function finishFold(scroll = false, behavior: ScrollBehavior = motion.matches ? 'instant' : 'smooth') {
    operation++;
    folds.forEach(animation => animation.cancel());
    folds = [];
    details.open = desiredOpen;
    content.inert = !desiredOpen;
    details.style.removeProperty('overflow');
    delete details.dataset.fold;
    // Only an explicit opening may move the footer. Restoring history must preserve its position.
    if (scroll && openingByReader && desiredOpen && content.getBoundingClientRect().top > innerHeight * .65) {
      details.scrollIntoView({ block: 'start', behavior });
    }
    openingByReader = false;
  }
  function revealSpecimen() {
    stopSpecimen();
    if (motion.matches || typeof specimen.animate !== 'function') return;
    specimenAnimation = specimen.animate([
      { transform: 'translateY(6px)' },
      { transform: 'none' },
    ], { duration: 240, easing: 'cubic-bezier(.22, 1, .36, 1)' });
    void specimenAnimation.finished.catch(() => {});
  }
  function fold(open: boolean, byReader = true) {
    desiredOpen = open;
    openingByReader = open && byReader;
    if (!open && content.contains(document.activeElement)) summary.focus({ preventScroll: true });
    content.inert = !open;
    stopSpecimen();
    if (motion.matches || typeof details.animate !== 'function') {
      finishFold(true);
      return;
    }
    if (!folds.length) {
      const closedHeight = summary.offsetHeight;
      details.open = true;
      const fullHeight = details.offsetHeight;
      const shadow = getComputedStyle(sheet).boxShadow;
      const easing = 'cubic-bezier(.22, 1, .36, 1)';
      const timing = { duration: 480, fill: 'both' as const, easing: 'linear' };
      // A shared timeline lets another click reverse the current fold without a jump.
      folds = [
        details.animate([{ height: `${closedHeight}px` }, { height: `${fullHeight}px` }], { ...timing, easing }),
        sheet.animate([
          { transform: 'perspective(900px) rotateX(-64deg)', boxShadow: '2px 12px 14px rgb(20 16 25 / .16)', easing },
          { transform: 'none', boxShadow: shadow, offset: .72 },
          { transform: 'none', boxShadow: shadow },
        ], timing),
        sheetContent.animate([
          { clipPath: 'inset(0 0 100% 0)', transform: 'translateY(-8px)' },
          { clipPath: 'inset(0 0 100% 0)', transform: 'translateY(-8px)', offset: .2, easing },
          { clipPath: 'inset(0)', transform: 'none' },
        ], timing),
        controls.animate([
          { clipPath: 'inset(0 100% 0 0)', transform: 'translateX(-10px)' },
          { clipPath: 'inset(0 100% 0 0)', transform: 'translateX(-10px)', offset: .35, easing },
          { clipPath: 'inset(0)', transform: 'none' },
        ], timing),
        intro.animate([{ clipPath: 'inset(0 0 100% 0)' }, { clipPath: 'inset(0)' }], { ...timing, easing }),
      ];
      folds.forEach(animation => { animation.currentTime = open ? 0 : 480; });
    }
    details.style.overflow = 'hidden';
    details.dataset.fold = open ? 'opening' : 'closing';
    const currentOperation = ++operation;
    folds.forEach(animation => {
      animation.playbackRate = open ? 1 : -1.5;
      animation.play();
      // Both reversal and page lifecycle cleanup can cancel a pending finished promise.
      void animation.finished.catch(() => {});
    });
    void folds[0].finished.then(() => {
      if (currentOperation === operation) finishFold(true);
    }, () => {});
  }
  summary.addEventListener('click', (event) => {
    event.preventDefault();
    summary.focus({ preventScroll: true });
    fold(!desiredOpen);
  });
  details.addEventListener('toggle', () => {
    // Native external changes (including find-in-page) settle immediately, without replaying a fold.
    if (!details.open && (desiredOpen || folds.length) || details.open && !desiredOpen && !folds.length) {
      desiredOpen = details.open;
      if (!desiredOpen && content.contains(document.activeElement)) summary.focus({ preventScroll: true });
      finishFold();
    }
  });
  content.addEventListener('focusin', () => {
    // Readers can enter the editor immediately; moving or clipped controls must never delay input.
    // WebKit's native focus scroll can cancel a smooth scroll started inside focusin.
    if (folds.length && desiredOpen) finishFold(true, 'instant');
  });
  details.addEventListener('keydown', (event) => {
    if (event.key !== 'Escape' || event.isComposing || !details.open) return;
    event.preventDefault();
    fold(false);
    summary.focus({ preventScroll: true });
  });
  weight.addEventListener('input', () => {
    specimen.style.fontWeight = weight.value;
    weightValue.value = weight.value;
  });
  details.querySelectorAll<HTMLInputElement>('input[name="specimen-face"]').forEach(input => input.addEventListener('change', () => {
    sheet.dataset.face = input.value;
    faceName.textContent = input.value === 'oswald' ? 'Oswald' : 'Newsreader';
    revealSpecimen();
  }));
  details.querySelectorAll<HTMLInputElement>('input[name="specimen-paper"]').forEach(input => input.addEventListener('change', () => { sheet.dataset.paper = input.value; }));
  details.querySelector('[data-next-phrase]')!.addEventListener('click', () => {
    phrase = (phrase + 1) % phrases.length;
    specimen.value = phrases[phrase];
    status.textContent = `New phrase: ${phrases[phrase].replace('\n', ' ')}`;
    revealSpecimen();
  });
  details.querySelector('[data-reset-type]')!.addEventListener('click', () => {
    phrase = 0;
    specimen.value = phrases[0];
    specimen.style.removeProperty('font-weight');
    weight.value = weightValue.value = '600';
    sheet.dataset.face = 'oswald';
    sheet.dataset.paper = 'cream';
    faceName.textContent = 'Oswald';
    details.querySelectorAll<HTMLInputElement>('input[type="radio"]').forEach(input => { input.checked = input.defaultChecked; });
    status.textContent = 'Type specimen reset.';
    revealSpecimen();
  });
  // Safari does not focus buttons on click. Keep subsequent Escape/Tab inside the disclosure.
  details.querySelectorAll<HTMLButtonElement>('button').forEach(button => button.addEventListener('click', () => button.focus({ preventScroll: true })));
  function settle() {
    stopSpecimen();
    finishFold();
    details.getAnimations?.({ subtree: true }).forEach(animation => animation.cancel());
  }
  motion.addEventListener('change', () => { if (motion.matches) { stopSpecimen(); finishFold(true); } });
  addEventListener('resize', () => { if (folds.length) finishFold(true); });
  addEventListener('pagehide', settle);
  addEventListener('pageshow', settle);
  document.addEventListener('visibilitychange', () => { if (document.hidden) settle(); });
  content.inert = !details.open;
  controls.hidden = false;
</script>
<style>
  .colophon { margin-top: 16px; scroll-margin-top: 24px; }
  .colophon > summary { display: flex; align-items: center; gap: 16px; width: fit-content; min-height: 44px; padding: 8px 0; color: var(--muted); font-size: 17px; cursor: pointer; list-style: none; }
  .colophon > summary::-webkit-details-marker { display: none; }
  .colophon > summary:hover { color: var(--accent); }
  .colophon-toggle { font-family: ui-monospace, monospace; font-size: 23px; line-height: 1; transition: transform 220ms ease; }
  .colophon[open] .colophon-toggle { transform: rotate(45deg); }
  .colophon[data-fold='closing'] .colophon-toggle { transform: none; }
  .colophon-content { padding: 30px 0 14px; }
  .colophon-intro { display: grid; grid-template-columns: 1fr 1fr; gap: 40px; align-items: end; margin-bottom: 28px; }
  .colophon-label { color: var(--muted); font: 12px/1.4 ui-monospace, monospace; letter-spacing: .07em; text-transform: uppercase; margin-bottom: 12px; }
  .colophon h2 { font-size: 38px; line-height: 1.15; }
  .colophon-intro > p { max-width: 440px; color: var(--muted); font-size: 20px; line-height: 1.45; }
  .type-playground { display: grid; grid-template-columns: minmax(0, 1fr) 280px; gap: 40px; align-items: start; }
  .type-sheet { --specimen-paper: #faf8f2; --specimen-ink: #24212c; background: var(--specimen-paper); color: var(--specimen-ink); padding: 26px 32px 22px; border: 1px solid var(--line); box-shadow: 4px 5px 0 var(--paper), 5px 6px 0 var(--line); transform-origin: 50% 0; transition: background-color 220ms ease, color 220ms ease; }
  .type-sheet[data-paper='lilac'] { --specimen-paper: #e4dbee; }
  .type-sheet[data-paper='ink'] { --specimen-paper: #24212c; --specimen-ink: #f4f0e6; }
  .specimen-caption { display: flex; flex-wrap: wrap; justify-content: space-between; gap: 8px; margin-bottom: 28px; font: 12px/1.4 ui-monospace, monospace; }
  #specimen-text { display: block; width: 100%; height: 260px; margin: 0; padding: 0; border: 0; border-radius: 0; background: transparent; color: inherit; -webkit-text-fill-color: currentColor; caret-color: currentColor; font-family: var(--display); font-size: clamp(44px, 5.7vw, 74px); font-weight: 600; line-height: 1.08; letter-spacing: -.02em; resize: vertical; overflow-wrap: anywhere; }
  #specimen-text:focus-visible { outline-color: var(--specimen-ink); }
  #specimen-text::selection { background: var(--specimen-ink); color: var(--specimen-paper); }
  [data-face='newsreader'] #specimen-text { font-family: var(--serif); font-optical-sizing: auto; }
  #specimen-hint { margin-top: 24px; font: 14px/1.4 var(--serif); }
  .type-controls { display: grid; gap: 24px; padding-top: 2px; min-width: 0; }
  .type-controls fieldset { margin: 0; padding: 0; border: 0; min-width: 0; }
  .type-controls legend, .weight-label { margin-bottom: 10px; font-size: 18px; }
  .weight-label { display: flex; justify-content: space-between; gap: 16px; align-items: center; }
  .weight-label output, .weight-extents { color: var(--muted); font: 12px/1.4 ui-monospace, monospace; }
  #specimen-weight { display: block; width: 100%; min-height: 44px; margin: 0; padding: 0; accent-color: var(--accent); cursor: ew-resize; }
  .weight-extents { display: flex; justify-content: space-between; }
  .type-options, .paper-options { display: flex; flex-wrap: wrap; gap: 8px; }
  .type-options label, .paper-options label { display: flex; align-items: center; gap: 7px; position: relative; min-height: 44px; padding: 9px 11px; border: 1px solid var(--line); font-size: 16px; cursor: pointer; }
  .type-options input, .paper-options input { position: absolute; opacity: 0; width: 1px; height: 1px; }
  .type-options label:has(:checked), .paper-options label:has(:checked) { border-color: var(--accent); background: var(--surface); box-shadow: inset 0 -2px var(--accent); }
  .type-options label:has(:focus-visible), .paper-options label:has(:focus-visible) { outline: 2px solid var(--accent); outline-offset: 4px; }
  .type-options label:hover, .paper-options label:hover { border-color: var(--accent); }
  .paper-swatch { width: 12px; height: 12px; border: 1px solid var(--muted); border-radius: 50%; }
  .paper-cream { background: #faf8f2; }
  .paper-lilac { background: #e4dbee; }
  .paper-ink { background: #24212c; }
  .specimen-actions { display: flex; align-items: center; justify-content: space-between; gap: 12px; border-top: 1px solid var(--line); padding-top: 14px; }
  .specimen-actions button { min-height: 44px; padding: 8px 0; border: 0; background: none; color: var(--accent); font-size: 17px; text-decoration: underline; text-underline-offset: 5px; }
  .specimen-actions [data-reset-type] { color: var(--muted); }
  @media (max-width: 760px) {
    .colophon { margin-top: 10px; }
    .colophon-content { padding-top: 20px; }
    .colophon-intro, .type-playground { grid-template-columns: minmax(0, 1fr); gap: 24px; }
    .colophon h2 { font-size: 32px; }
    .colophon-intro > p { font-size: 19px; }
    .type-sheet { padding: 22px; }
    #specimen-text { height: 220px; font-size: clamp(38px, 10vw, 62px); }
    .type-controls { margin-top: 4px; }
  }
</style>
