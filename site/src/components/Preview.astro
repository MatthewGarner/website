---
import { description, excerpt, noteHref, readLabel, type Note } from '../lib/content';
interface Props { note: Note; }
const { note } = Astro.props;
---
<div class="preview-copy">
  <p class="eyebrow">Preview</p>
  <h3>{note.data.title}</h3>
  {note.data.description && <p class="preview-description">{description(note)}</p>}
  <p class="preview-excerpt">{excerpt(note)}</p>
  <a class="text-link" href={noteHref(note.id)}>{readLabel(note)}</a>
</div>
