  [data-home-arrival] .preview-panel::before {
    animation: arrive-paper-back 720ms 150ms cubic-bezier(.22, 1, .36, 1) backwards;
  }
  [data-home-arrival] .preview-panel::after {
    animation: arrive-paper-middle 660ms 210ms cubic-bezier(.22, 1, .36, 1) backwards;
  }
