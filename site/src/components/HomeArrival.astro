    /* Only the paper and shadow move; links remain under the reader's pointer. */
    animation: arrive-paper-light 720ms 150ms ease backwards;
  }
  @keyframes arrive-type {
    from { transform: translateY(112%); font-weight: 570; }
    75% { transform: translateY(-1%); font-weight: 700; }
    to { transform: none; font-weight: 700; }
  }
  @keyframes arrive-copy { from { transform: translateY(20px); } to { transform: none; } }
  @keyframes arrive-rule { from { transform: scaleX(0); } to { transform: scaleX(1); } }
  @keyframes arrive-paper-back {
    from { transform: rotate(-.7deg); }
    35% { transform: translate(calc(-1 * var(--fan-shift)), 3px) rotate(var(--fan-left)); box-shadow: 0 10px 20px rgb(0 0 0 / .10); }
    to { transform: rotate(-.7deg); box-shadow: none; }
  }
  @keyframes arrive-paper-middle {
    from { transform: rotate(1deg); }
    35% { transform: translate(var(--fan-shift), -4px) rotate(var(--fan-right)); box-shadow: 0 6px 16px rgb(0 0 0 / .08); }
    to { transform: rotate(1deg); box-shadow: none; }
  }
  @keyframes arrive-paper-light {
    from, to { box-shadow: 0 5px 15px rgb(0 0 0 / .035); }
    38% { box-shadow: 0 14px 24px rgb(0 0 0 / .13); }
  }
  @media (max-width: 1050px) {
    [data-home-arrival] .preview-panel { --fan-left: -2deg; --fan-right: 1.7deg; --fan-shift: 4px; }
  }
  @media print {
    [data-home-arrival] .headline-line { clip-path: none; }
    [data-home-arrival] :is(.headline-line-ink, .intro-copy > p, .preview-copy),
    [data-home-arrival] .preview-panel::before, [data-home-arrival] .preview-panel::after,
    [data-home-arrival] .section-heading::before, [data-home-arrival] .section-heading::after { animation: none; }
  }
</style>
