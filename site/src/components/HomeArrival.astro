<!-- Set the arrival state before paint. CSS completes the sequence even if a later script fails. -->
<script is:inline>
  (() => {
    const root = document.documentElement;
    const motion = matchMedia('(prefers-reduced-motion: reduce)');
    const navigation = performance.getEntriesByType('navigation')[0];
    const reloading = navigation?.type === 'reload';
    const internal = document.referrer && new URL(document.referrer).origin === location.origin;
    // WebKit can restore scrolling after pageshow. Remember the outgoing entry
    // before deciding whether a reload should animate, including after Back.
    const restoringScroll = reloading && history.state?.mgHomeScrolled === true;
    addEventListener('pagehide', () => {
      try { history.replaceState({ ...history.state, mgHomeScrolled: scrollY > 0 }, ''); } catch {}
    });
    // A restored page or a deliberate destination should never run an entrance over the reader's place.
    if ((internal && !reloading) || navigation?.type === 'back_forward' || restoringScroll || location.hash || motion.matches) return;
    let shown = !reloading;
    let started = false;
    let finished = false;
    let timer;
    function start() {
      if (!shown || started || finished || document.hidden) return;
      if (motion.matches || scrollY > 0) { settle(); return; }
      started = true;
      root.setAttribute('data-home-arrival', '');
      // A cold WebKit compositor can lag page scripts. Actual animation completion
      // controls cleanup; this timer only handles unavailable animation events.
      timer = setTimeout(settle, 5000);
    }
    function settle() {
      finished = true;
      root.removeAttribute('data-home-arrival');
      clearTimeout(timer);
      for (const type of ['pointerdown', 'keydown', 'wheel', 'touchstart']) document.removeEventListener(type, settle, true);
      removeEventListener('scroll', onScroll);
      removeEventListener('pagehide', settle);
      document.removeEventListener('visibilitychange', onVisibility);
      document.removeEventListener('home-arrival-settle', settle);
      document.removeEventListener('animationend', onAnimationEnd);
      motion.removeEventListener('change', settle);
    }
    function onVisibility() {
      // A new background tab still deserves its first entrance when it becomes visible.
      if (!document.hidden) start();
      else if (started) settle();
    }
    function onScroll() { if (scrollY !== 0) settle(); }
    function onAnimationEnd(event) {
      if (!event.animationName.startsWith('arrive-')) return;
      const animations = document.getAnimations?.();
      if (animations && !animations.some(animation => animation.animationName?.startsWith('arrive-') && animation.playState !== 'finished')) settle();
    }
    for (const type of ['pointerdown', 'keydown', 'wheel', 'touchstart']) document.addEventListener(type, settle, { capture: true, passive: true });
    addEventListener('scroll', onScroll, { passive: true });
    // Initial viewport and browser-chrome resize events are not reader interaction.
    // CSS already adapts these animations to the current viewport without cancellation.
    addEventListener('pagehide', settle);
    document.addEventListener('visibilitychange', onVisibility);
    motion.addEventListener('change', settle);
    document.addEventListener('home-arrival-settle', settle);
    document.addEventListener('animationend', onAnimationEnd);
    // Do not replay after a bfcache restore, including browsers without navigation timing.
    addEventListener('pageshow', (event) => {
      if (event.persisted) { settle(); return; }
      // On reload, let the browser restore its scroll position before deciding to animate.
      shown = true;
      start();
    });
    document.addEventListener('DOMContentLoaded', () => {
      if (scrollY > 0) settle();
    }, { once: true });
    start();
  })();
</script>
<style is:global>
  [data-home-arrival] .headline-line { clip-path: inset(-.08em -.06em -.12em); }
  [data-home-arrival] .headline-line-ink { animation: arrive-type 580ms cubic-bezier(.22, 1, .36, 1) backwards; }
  [data-home-arrival] .headline-line:nth-child(2) .headline-line-ink { animation-delay: 85ms; }
  [data-home-arrival] .headline-line:nth-child(3) .headline-line-ink { animation-delay: 170ms; }
  [data-home-arrival] .intro-copy > p { animation: arrive-copy 500ms 150ms cubic-bezier(.22, 1, .36, 1) backwards; }
  [data-home-arrival] .section-heading { position: relative; border-color: transparent; }
  [data-home-arrival] .section-heading::before, [data-home-arrival] .section-heading::after {
    content: ''; position: absolute; pointer-events: none; left: 0; right: 0; height: 1px; background: var(--line);
    transform-origin: left; animation: arrive-rule 480ms 240ms cubic-bezier(.22, 1, .36, 1) backwards;
  }
  [data-home-arrival] .section-heading::before { top: -1px; }
  [data-home-arrival] .section-heading::after { bottom: -1px; animation-delay: 310ms; }
