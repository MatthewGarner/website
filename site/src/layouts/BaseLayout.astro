---
import '@fontsource-variable/newsreader/standard-italic.css';
import '../styles/global.css';
import '../identity/identity.css';
import themeInitUrl from '../identity/theme-init.js?url&no-inline';
import circleHalf from '@phosphor-icons/core/assets/fill/circle-half-fill.svg?raw';
import ReadingTransition from '../components/ReadingTransition.astro';
import Colophon from '../components/Colophon.astro';
import HomeArrival from '../components/HomeArrival.astro';
import { listedPersonalPages } from '../lib/content';
interface Props { title?: string; description?: string; article?: boolean; localDraft?: boolean; socialImage?: string; }
const { title, description = 'Writing about technology, work and the things in between. Small tools for thinking clearly.', article = false, localDraft = false, socialImage } = Astro.props;
const pageTitle = title ? `${title} — Matthew Garner` : 'Matthew Garner';
const imageUrl = new URL(socialImage || '/static/og-image.png', Astro.site);
const imageAlt = socialImage ? pageTitle : 'Matthew Garner — writing and small tools';
// Directory builds add a slash; public routes redirect to the slashless URL.
const canonical = new URL(Astro.url.pathname.replace(/\/+$/, '') || '/', Astro.site);
const current = Astro.url.pathname;
const availablePages = new Set((await listedPersonalPages()).map((note) => note.id));
---
<!doctype html>
<html lang="en-GB">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    {current === '/' && <HomeArrival />}
    {(article || current === '/') && <ReadingTransition />}
    <script is:inline src={themeInitUrl}></script>
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    {localDraft && <meta name="robots" content="noindex, nofollow" />}
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/x-icon" href="/static/icon.ico?v=m1" sizes="16x16 32x32 48x48 64x64 128x128 256x256" />
    <link rel="alternate" type="application/rss+xml" title="Matthew Garner — Writing" href="/index.xml" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={article ? 'article' : 'website'} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={imageUrl} />
    <meta property="og:image:alt" content={imageAlt} />
    {socialImage && <><meta property="og:image:type" content="image/png" /><meta property="og:image:width" content="1200" /><meta property="og:image:height" content="630" /></>}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={imageUrl} />
    <meta name="twitter:image:alt" content={imageAlt} />
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <div class="site-frame">
      <header class="mg-masthead site-header">
        <a class="mg-identity identity" href="/" aria-current={current === '/' ? 'page' : undefined}>Matthew Garner</a>
        <nav class="mg-nav primary-nav" aria-label="Main navigation">
          <a href="/writing" aria-current={current === '/writing' || current === '/writing/' ? 'page' : undefined}>Writing</a>
          <a href="https://tools.matthewgarner.me/">Tools Lab</a>
          {availablePages.has('now') && <a href="/now" aria-current={current.replace(/\/$/, '') === '/now' ? 'page' : undefined}>Now</a>}
        </nav>
        <button class="mg-appearance appearance" type="button" aria-label="Appearance: toggle light and dark mode">
          <span class="mg-icon icon" aria-hidden="true" set:html={circleHalf} />
        </button>
      </header>
      <main id="main" tabindex="-1">
        {localDraft && <aside class="draft-notice" aria-label="Draft preview"><strong>Draft preview</strong><p>Only visible on this machine. This piece is excluded from published builds.</p></aside>}
        <slot />
      </main>
      <footer class="site-footer">
        <nav class="footer-links" aria-label="Elsewhere">
          <a href="/about" aria-current={current.replace(/\/$/, '') === '/about' ? 'page' : undefined}>About</a>
          {availablePages.has('bookshelf') && <a href="/bookshelf" aria-current={current.replace(/\/$/, '') === '/bookshelf' ? 'page' : undefined}>Bookshelf</a>}
          <a href="/index.xml">RSS</a>
          <a href="https://github.com/matthewgarner">GitHub</a>
          <a href="https://www.linkedin.com/in/matthew-garner-uk/">LinkedIn</a>
        </nav>
        <button class="mg-theme-reset" type="button" data-mg-theme-reset hidden>Use system appearance</button>
        <Colophon />
      </footer>
    </div>
    <script>
      import '../identity/appearance.js';
    </script>
  </body>
</html>
