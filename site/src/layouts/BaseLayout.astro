---
import '@fontsource-variable/oswald';
import '@fontsource-variable/newsreader/standard.css';
import '@fontsource-variable/newsreader/standard-italic.css';
import '../styles/global.css';
import circleHalf from '@phosphor-icons/core/assets/fill/circle-half-fill.svg?raw';
interface Props { title?: string; description?: string; article?: boolean; localDraft?: boolean; }
const { title, description = 'Writing about technology, work and the things in between. Small tools for thinking clearly.', article = false, localDraft = false } = Astro.props;
const pageTitle = title ? `${title} — Matthew Garner` : 'Matthew Garner';
const canonical = new URL(Astro.url.pathname, Astro.site);
const current = Astro.url.pathname;
---
<!doctype html>
<html lang="en-GB">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <script is:inline>
      (() => {
        let preference = 'system';
        try { preference = localStorage.getItem('mg:appearance') || 'system'; } catch {}
        const dark = preference === 'dark' || (preference !== 'light' && matchMedia('(prefers-color-scheme: dark)').matches);
        document.documentElement.dataset.theme = dark ? 'dark' : 'light';
        document.documentElement.style.colorScheme = dark ? 'dark' : 'light';
      })();
    </script>
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    {localDraft && <meta name="robots" content="noindex, nofollow" />}
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/static/icon.ico" sizes="any" />
    <link rel="alternate" type="application/rss+xml" title="Matthew Garner — Writing" href="/index.xml" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={article ? 'article' : 'website'} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={new URL('/static/og-image.png', Astro.site)} />
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <div class="site-frame">
      <header class="site-header">
        <a class="identity" href="/" aria-current={current === '/' ? 'page' : undefined}>Matthew Garner</a>
        <nav class="primary-nav" aria-label="Main navigation">
          <a href="/writing" aria-current={current === '/writing' || current === '/writing/' ? 'page' : undefined}>Writing</a>
          <a href="/about" aria-current={current === '/about' || current === '/about/' ? 'page' : undefined}>About</a>
        </nav>
        <button class="appearance" type="button" aria-label="Appearance: toggle light and dark mode">
          <span class="icon" aria-hidden="true" set:html={circleHalf} /><span>Appearance</span>
        </button>
      </header>
      <main id="main" tabindex="-1">
        {localDraft && <aside class="draft-notice" aria-label="Draft preview"><strong>Draft preview</strong><p>Only visible on this machine. This piece is excluded from published builds.</p></aside>}
        <slot />
      </main>
      <footer class="site-footer" aria-label="Elsewhere">
        <a href="/index.xml">RSS</a>
        <a href="https://github.com/matthewgarner">GitHub</a>
        <a href="https://www.linkedin.com/in/matthew-garner-uk/">LinkedIn</a>
      </footer>
    </div>
    <script>
      const preferenceKey = 'mg:appearance';
      const systemTheme = matchMedia('(prefers-color-scheme: dark)');
      const reducedMotion = matchMedia('(prefers-reduced-motion: reduce)');
      const appearance = document.querySelector<HTMLButtonElement>('.appearance')!;
      const root = document.documentElement;
      type Theme = 'light' | 'dark';
      const savedTheme = (value: string | null): Theme | null => value === 'light' || value === 'dark' ? value : null;
      let preference: Theme | null = null;
      try { preference = savedTheme(localStorage.getItem(preferenceKey)); } catch {}
      const currentTheme = (): Theme => preference ?? (systemTheme.matches ? 'dark' : 'light');
      let transition: ViewTransition | undefined;
      let revision = 0;
      let fadeTimer: ReturnType<typeof setTimeout>;

      function applyTheme(animate = false) {
        const theme = currentTheme();
        const change = ++revision;
        transition?.skipTransition();
        const update = () => {
          // A fast second tap must win even if the previous snapshot is pending.
          if (change !== revision) return;
          root.dataset.theme = theme;
          root.style.colorScheme = theme;
          const action = `Switch to ${theme === 'light' ? 'dark' : 'light'} mode`;
          appearance.setAttribute('aria-label', `Appearance: ${action.toLowerCase()}`);
          appearance.title = action;
        };
        if (!animate || reducedMotion.matches || root.dataset.theme === theme) {
          update();
        } else if (typeof document.startViewTransition === 'function') {
          const next = document.startViewTransition(update);
          transition = next;
          // Skipping a transition rejects ready, but still applies its update.
          void next.ready.catch(() => {});
          void next.finished.then(() => { if (transition === next) transition = undefined; });
        } else {
          root.classList.add('theme-fade');
          clearTimeout(fadeTimer);
          update();
          fadeTimer = setTimeout(() => root.classList.remove('theme-fade'), 400);
        }
      }
      appearance.addEventListener('click', () => {
        preference = currentTheme() === 'light' ? 'dark' : 'light';
        try { localStorage.setItem(preferenceKey, preference); } catch {}
        applyTheme(true);
      });
      systemTheme.addEventListener('change', () => { if (preference === null) applyTheme(true); });
      window.addEventListener('storage', (event) => {
        if (event.key === preferenceKey || event.key === null) {
          preference = savedTheme(event.newValue);
          applyTheme(true);
        }
      });
      applyTheme();
    </script>
  </body>
</html>
